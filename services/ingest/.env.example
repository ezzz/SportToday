# XMLTVFr direct feed. The France feed is preferred for this POC.
XMLTVFR_URL=https://xmltvfr.fr/xmltv/xmltv_fr.xml.gz

# Direct public feed announced by XMLTVFREE.
XMLTVFREE_URL=http://xmltvfree.free.fr/xmltv.xml.gz

# The free TheSportsDB key is enough for adapter and matching smoke tests.
THESPORTSDB_API_KEY=123

# API-Football credential. Keep the real value only in .env, never in Git.
API_FOOTBALL_KEY=

# API-Sports Volleyball uses the same API-Sports account/key by default.
# Set this only if it differs from API_FOOTBALL_KEY.
API_VOLLEYBALL_KEY=

# Optional API-Tennis account (separate provider and key).
API_TENNIS_KEY=

# Optional ESPN public scoreboard fallback for golf (POC only).
ESPN_GOLF_ENABLED=true

# Public World Athletics Diamond League calendar page (day-level times are estimated).
WORLD_ATHLETICS_URL=https://worldathletics.org/competitions/diamond-league/calendar-results

# Community F1 calendar API; no API key is required.
JOLPICA_F1_BASE_URL=https://api.jolpi.ca/ergast/f1

# Optional local override. Do not commit the resulting .env file.
INGEST_DATA_DIR=./data
